# =============================================================================
# Daily Activity PKL - Template Environment (Supabase / tanpa Docker)
# =============================================================================
# Salin file ini menjadi .env lalu isi nilainya:
#   copy .env.example .env
#
# 1. Ganti <PASSWORD> dengan password database Supabase.
# 2. Samakan <project-ref> dan <region> dengan project Supabase kamu
#    (Supabase -> Connect / Project Settings -> Database).
# 3. Untuk Vercel: isi variabel yang sama di
#    Vercel -> Project -> Settings -> Environment Variables
#    (Production DAN Preview), lalu Redeploy.
# Jangan pernah menaruh password asli di file ini atau di Git.
# =============================================================================

# ----------------------------- Database (Supabase) --------------------------
# Runtime aplikasi & Prisma Client -> Transaction Pooler (port 6543).
# WAJIB pakai ?pgbouncer=true. connection_limit=1 disarankan untuk serverless.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Migrasi saat deploy (prisma migrate deploy) -> Session Pooler (port 5432).
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# -------------------------------- Aplikasi ----------------------------------
# Kunci penandatangan sesi JWT. Wajib diganti dengan string acak minimal 32 karakter.
AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"

# URL publik aplikasi. Lokal: http://localhost:3000.
# Produksi: ganti ke URL Vercel, mis. https://dialy-activity.vercel.app
APP_URL="http://localhost:3000"

# ----------------------------- Email (opsional) -----------------------------
# Kosongkan SMTP_HOST -> email hanya dicatat di tabel EmailOutbox (tidak terkirim).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Daily Activity PKL <no-reply@transhybrid.test>"

# Masa berlaku tautan aman email (hari)
LINK_EXPIRY_DAYS="7"
