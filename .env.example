# Koneksi database utama (dipakai aplikasi & Prisma)
DATABASE_URL="postgresql://pkl:pkl@localhost:5432/pkl_daily?schema=public"

# Secret untuk menandatangani sesi (ganti di produksi)
AUTH_SECRET="ganti-secret-ini-minimal-32-karakter-ya"

# Base URL publik (dipakai untuk tautan verifikasi QR & tautan email)
APP_URL="http://localhost:3000"

# SMTP untuk pengiriman email. Jika kosong, email hanya dicatat di database (outbox).
SMTP_HOST=""
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Daily Activity PKL <no-reply@transhybrid.test>"

# Masa berlaku tautan aman email (hari)
LINK_EXPIRY_DAYS="7"
