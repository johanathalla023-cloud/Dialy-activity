# Koneksi database utama (dipakai aplikasi & Prisma)
DATABASE_URL= "postgresql://postgres.qdodsdcecqsfotpjgkyx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"
# Koneksi langsung/session pooler Supabase untuk migrasi Prisma saat deploy.
DIRECT_URL="postgresql://postgres.qdodsdcecqsfotpjgkyx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Untuk Supabase di Vercel, gunakan Transaction Pooler (port 6543) dan tambahkan
# ?pgbouncer=true pada DATABASE_URL. DIRECT_URL gunakan Session Pooler (port 5432).
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Secret untuk menandatangani sesi (ganti di produksi)
AUTH_SECRET="ganti-secret-ini-minimal-32-karakter-ya"

# Base URL publik (dipakai untuk tautan verifikasi QR & tautan email)
APP_URL="http://localhost:3000"

# SMTP untuk pengiriman email. Jika kosong, email hanya dicatat di database (outbox).
SMTP_HOST=""
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Daily Activity PKL <no-reply@transhybrid.test>"

# Masa berlaku tautan aman email (hari)
LINK_EXPIRY_DAYS="7"
