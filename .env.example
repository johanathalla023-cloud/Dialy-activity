# Koneksi database utama (dipakai aplikasi & Prisma).
# Untuk Supabase di Vercel: Transaction Pooler (port 6543) + ?pgbouncer=true&connection_limit=1.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Koneksi langsung/Session Pooler Supabase (port 5432) untuk migrasi Prisma saat deploy.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# PENTING: Vercel TIDAK membaca file .env ini. Salin nilainya ke
# Vercel → Project → Settings → Environment Variables (Production & Preview),
# lalu redeploy. Ganti <project-ref>, <region>, dan <password> dengan nilai asli
# dari Supabase → Project Settings → Database → Connection pooling.
# Jangan pernah menaruh password asli di file ini atau di Git.

# Secret untuk menandatangani sesi (ganti di produksi)
AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"

# Base URL publik (dipakai untuk tautan verifikasi QR & tautan email)
APP_URL="http://localhost:3000"

# SMTP untuk pengiriman email. Jika kosong, email hanya dicatat di database (outbox).
SMTP_HOST=""
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Daily Activity PKL <no-reply@transhybrid.test>"

# Masa berlaku tautan aman email (hari)
LINK_EXPIRY_DAYS="7"
